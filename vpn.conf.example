# Generated by setup.sh from the .ovpn profile downloaded from the AWS Client
# VPN console. It is the same profile minus the remote/auth lines, which the
# scripts inject dynamically. This file is gitignored on purpose.
client
dev tun
proto udp
resolv-retry infinite
nobind
remote-cert-tls server
cipher AES-256-GCM
verb 3
<ca>
-----BEGIN CERTIFICATE-----
... CA certificate copied from your .ovpn profile ...
-----END CERTIFICATE-----
</ca>

auth-nocache
reneg-sec 0

verify-x509-name vpn.example.com name
